# Parent identity database ONLY. Never use the CRM database here.
APP_ENV=local
APP_URL=http://localhost:3100
DATABASE_URL=
DIRECT_URL=
BETTER_AUTH_SECRET=
# Dedicated lotos_parent_reader PostgreSQL role in the existing CRM database.
CRM_READ_DATABASE_URL=
# Base64 encoded PEM certificate; required for remote PostgreSQL with verified TLS.
DATABASE_CA_BASE64=
CRM_DATABASE_CA_BASE64=
# Preview works only in explicit local profile and never on Vercel.
PARENT_PREVIEW=0
