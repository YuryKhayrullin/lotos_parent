{
  "name": "lotos-parent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build --webpack",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "env:check": "node --conditions=react-server --import tsx scripts/check-environment.ts",
    "test:integration": "node ../lotos_crm/scripts/test-parent-portal.mjs",
    "format": "prettier --write app components lib scripts tests *.json *.mjs *.ts docs README.md",
    "format:check": "prettier --check app components lib scripts tests *.json *.mjs *.ts docs README.md"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
