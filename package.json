{
  "name": "lotos-parent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "prebuild": "prisma generate",
    "build": "next build --webpack",
    "start": "next start --port 3100",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "prisma generate",
    "env:check": "tsx scripts/check-environment.ts",
    "parent:manage": "tsx scripts/manage-parent.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:contract": "tsx tests/crm-schema-contract.ts",
    "format": "prettier --write app components lib scripts tests *.json *.mjs *.ts docs README.md",
    "format:check": "prettier --check app components lib scripts tests *.json *.mjs *.ts docs README.md"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/functions": "3.9.11",
    "better-auth": "1.7.7",
    "lucide-react": "^1.45.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
