generator client {
  provider = "prisma-client"
  output = "../.generated/prisma"
  moduleFormat = "esm"
}
datasource db {
  provider = "postgresql"
  schemas = ["parent"]
}
model User {
  id String @id @default(uuid())
  name String
  email String @unique
  emailVerified Boolean @default(false) @map("email_verified")
  image String?
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions Session[]
  accounts Account[]
  children ParentChildLink[]
  @@map("users")
  @@schema("parent")
}
model Session {
  id String @id @default(uuid())
  token String @unique
  userId String @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("parent")
}
model Account {
  id String @id @default(uuid())
  userId String @map("user_id")
  accountId String @map("account_id")
  providerId String @map("provider_id")
  password String?
  accessToken String? @map("access_token")
  refreshToken String? @map("refresh_token")
  idToken String? @map("id_token")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
  @@schema("parent")
}
model Verification {
  id String @id @default(uuid())
  identifier String
  value String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([identifier])
  @@map("verifications")
  @@schema("parent")
}
model ParentChildLink {
  id String @id @default(uuid())
  parentUserId String @map("parent_user_id")
  crmClientId String @map("crm_client_id") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  operatorNote String @map("operator_note") @db.VarChar(500)
  user User @relation(fields: [parentUserId], references: [id], onDelete: Restrict)
  @@unique([parentUserId, crmClientId])
  @@index([parentUserId, revokedAt])
  @@map("child_links")
  @@schema("parent")
}
model AuthRateBucket {
  key String @id @db.Char(64)
  hits Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("rate_buckets")
  @@schema("parent")
}
